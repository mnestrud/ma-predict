+def _dash_part_urls(manifest: bytes) -> list[str]:
+    """
+    Return the URL of every part (init segment, then media segments) of a DASH manifest.
+
+    An empty list means the manifest has a shape this does not read.
+
+    :param manifest: The MPD document.
+    """
+    try:
+        root = DefusedET.fromstring(manifest)
+    except DefusedET.ParseError:
+        return []
+    templates = [el for el in root.iter() if el.tag.rsplit("}", 1)[-1] == "SegmentTemplate"]
+    if len(templates) != 1:
+        return []
+    template = templates[0]
+    init, media = template.get("initialization"), template.get("media")
+    if not init or not media or "$Number$" not in media or "$Time$" in media:
+        return []
+    count = 0
+    for el in template.iter():
+        if el.tag.rsplit("}", 1)[-1] == "S":
+            count += 1 + int(el.get("r", "0"))
+    if count <= 0:
+        return []
+    start = int(template.get("startNumber", "1"))
+    return [init, *(media.replace("$Number$", str(n)) for n in range(start, start + count))]
+
