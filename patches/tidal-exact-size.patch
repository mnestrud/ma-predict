+async def test_stream_size_is_sum_of_parts(
+    streaming_manager: TidalStreamingManager, provider_mock: Mock, mock_track: Mock
+) -> None:
+    """With the option on the size is the sum of the parts, and it is remembered."""
+    provider_mock.config_values["exact_stream_size"] = True
+    provider_mock.get_track.return_value = mock_track
+    provider_mock.api.get.return_value = _dash_stream_data()
+    urls = _dash_part_urls(_MPD.encode())
+    head = _wire_part_sizes(
+        provider_mock, dict(zip(urls, [623, 500000, 510000, 505000, 3000], strict=True))
+    )
+
+    stream_details = await streaming_manager.get_stream_details("123")
+
+    assert stream_details.size == 623 + 500000 + 510000 + 505000 + 3000
+    assert head.call_count == 5
+    provider_mock.mass.cache.set.assert_awaited_once()
+    assert provider_mock.mass.cache.set.await_args.args[1] == stream_details.size
+
+    provider_mock.mass.cache.get = AsyncMock(return_value=stream_details.size)
+    head.reset_mock()
+    again = await streaming_manager.get_stream_details("123")
+    assert again.size == stream_details.size
+    head.assert_not_called()
+
