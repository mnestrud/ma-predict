+    async def _get_stream_size(
+        self, track_id: str, stream_data: dict[str, Any], url: str
+    ) -> int | None:
+        """
+        Return the size of a stream in bytes, or None when unknown or not asked for.
+
+        :param track_id: The track the stream belongs to.
+        :param stream_data: The playbackinfopostpaywall response.
+        :param url: The stream URL handed to the player pipeline.
+        """
+        if not self.provider.config.get_value(CONF_EXACT_STREAM_SIZE):
+            return None
+        if stream_data.get("manifestMimeType") == _MANIFEST_DASH and "manifest" in stream_data:
+            # a DASH stream is many small files: its size is the sum of theirs
+            part_urls = _dash_part_urls(base64.b64decode(stream_data["manifest"]))
+        else:
+            part_urls = [url]
+        if not part_urls:
+            return None
+        cache_key = (
+            f"{track_id}/{stream_data.get('audioQuality')}"
+            f"/{stream_data.get('bitDepth')}/{stream_data.get('sampleRate')}/{len(part_urls)}"
+        )
+        cached: int | None = await self.mass.cache.get(
+            cache_key, provider=self.provider.instance_id, category=CACHE_CATEGORY_STREAM_SIZE
+        )
+        if cached:
+            return cached
+        limit = asyncio.Semaphore(_SIZE_REQUESTS_PARALLEL)
+
+        async def _part_size(part_url: str) -> int | None:
+            async with (
+                limit,
+                self.mass.http_session.head(
+                    part_url,
+                    allow_redirects=True,
+                    timeout=ClientTimeout(total=_SIZE_REQUEST_TIMEOUT),
+                ) as response,
+            ):
+                if response.status != 200:
+                    return None
+                return response.content_length
+
+        try:
+            sizes = await asyncio.gather(*(_part_size(part_url) for part_url in part_urls))
+        except (ClientError, TimeoutError) as err:
+            self.provider.logger.debug("Stream size lookup failed for track %s: %s", track_id, err)
+            return None
+        if not all(sizes):
+            self.provider.logger.debug("Stream size lookup incomplete for track %s", track_id)
+            return None
+        size = sum(part for part in sizes if part)
+        await self.mass.cache.set(
+            cache_key,
+            size,
+            expiration=_SIZE_CACHE_EXPIRATION,
+            provider=self.provider.instance_id,
+            category=CACHE_CATEGORY_STREAM_SIZE,
+        )
+        return size
+
