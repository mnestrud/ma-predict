+_MPD = (
+    '<?xml version="1.0" encoding="UTF-8"?>'
+    '<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static">'
+    '<Period id="0"><AdaptationSet id="0" contentType="audio" mimeType="audio/mp4">'
+    '<Representation id="0" codecs="flac" bandwidth="1000000" audioSamplingRate="44100">'
+    '<SegmentTemplate timescale="44100" initialization="https://cdn.example/init.mp4?t=a&amp;b=1"'
+    ' media="https://cdn.example/$Number$.mp4?t=a&amp;b=1" startNumber="1">'
+    '<SegmentTimeline><S d="176128" r="2"/><S d="1000"/></SegmentTimeline>'
+    "</SegmentTemplate></Representation></AdaptationSet></Period></MPD>"
+)
+
+
+def _dash_stream_data() -> dict[str, Any]:
+    return {
+        "manifestMimeType": "application/dash+xml",
+        "manifest": base64.b64encode(_MPD.encode()).decode(),
+        "audioQuality": "LOSSLESS",
+        "sampleRate": 44100,
+        "bitDepth": 16,
+    }
+
+
+def _wire_part_sizes(provider_mock: Mock, sizes: dict[str, int | None], status: int = 200) -> Mock:
+    """Answer HEAD requests with the given Content-Length per URL; return the head mock."""
+
+    def _head(url: str, **_kwargs: Any) -> AsyncMock:
+        response = Mock(status=status, content_length=sizes[url])
+        context = AsyncMock()
+        context.__aenter__.return_value = response
+        return context
+
+    head = Mock(side_effect=_head)
+    provider_mock.mass.http_session.head = head
+    provider_mock.mass.cache.get = AsyncMock(return_value=None)
+    provider_mock.mass.cache.set = AsyncMock()
+    return head
+
+
+def test_dash_part_urls() -> None:
+    """The init segment and every media segment of the timeline are listed."""
+    assert _dash_part_urls(_MPD.encode()) == [
+        "https://cdn.example/init.mp4?t=a&b=1",
+        "https://cdn.example/1.mp4?t=a&b=1",
+        "https://cdn.example/2.mp4?t=a&b=1",
+        "https://cdn.example/3.mp4?t=a&b=1",
+        "https://cdn.example/4.mp4?t=a&b=1",
+    ]
+    assert _dash_part_urls(b"not xml") == []
+    assert _dash_part_urls(b"<MPD/>") == []
+
