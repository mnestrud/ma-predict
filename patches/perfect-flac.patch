+    source = (
+        f"sine=frequency=330:sample_rate=44100:duration={seconds},"
+        "aformat=channel_layouts=stereo,tremolo=f=0.2:d=0.9[a];"
+        f"anoisesrc=color=pink:sample_rate=44100:duration={seconds}:amplitude=0.2:seed=7,"
+        "aformat=channel_layouts=stereo[b];[a][b]amix=inputs=2:normalize=0"
+    )
+    args = [FFMPEG, "-v", "error", "-y", "-filter_complex", source]
+    args += ["-sample_fmt", "s16" if bit_depth == 16 else "s32", "-f", "flac"]
+    args += ["-compression_level", "0", "-frame_size", "4096", str(out)]
+    subprocess.run(args, check=True)  # noqa: S603
+    return out.read_bytes()
