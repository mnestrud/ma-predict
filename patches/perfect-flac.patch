+
+def _decode(data: bytes) -> bytes:
+    assert FFMPEG
+    args = [FFMPEG, "-v", "error", "-err_detect", "crccheck+explode", "-f", "flac", "-i", "-"]
+    result = subprocess.run(  # noqa: S603
+        [*args, "-f", "s32le", "-"], input=data, capture_output=True, check=True
+    )
+    assert not result.stderr
+    return result.stdout
+
+
+async def _decoder(
+    audio: AsyncGenerator[bytes], rate: int, bit_depth: int, channels: int
+) -> AsyncGenerator[bytes]:
+    assert FFMPEG
+    assert rate
+    assert channels
+    proc = await asyncio.create_subprocess_exec(
+        *[FFMPEG, "-v", "error", "-f", "flac", "-i", "-"],
+        *["-f", "s16le" if bit_depth == 16 else "s32le", "-"],
+        stdin=asyncio.subprocess.PIPE,
+        stdout=asyncio.subprocess.PIPE,
+    )
+    assert proc.stdin
+    assert proc.stdout
+    stdin, stdout = proc.stdin, proc.stdout
+
+    async def _feed() -> None:
+        async for chunk in audio:
+            stdin.write(chunk)
+            await stdin.drain()
+        stdin.close()
+
+    feeder = asyncio.create_task(_feed())
+    while chunk := await stdout.read(65536):
+        yield chunk
+    await feeder
+    await proc.wait()
+
+
+async def _run(
+    data: bytes, target: int, seconds: float, expected: int
+) -> tuple[bytes, pf.PerfectFlacResult]:
+    async def _source() -> AsyncGenerator[bytes]:
+        for pos in range(0, len(data), 7001):
+            yield data[pos : pos + 7001]
+            await asyncio.sleep(0)
+
+    stream = pf.PerfectFlacStream(
+        _source(), pf.PerfectFlacPlan(target, expected, seconds), LOGGER, _decoder
+    )
+    out = bytearray()
+    async for chunk in stream.stream():
+        out += chunk
+    return bytes(out), stream.result
+
+
+@needs_ffmpeg
+@pytest.mark.parametrize("bit_depth", [16, 24])
+@pytest.mark.parametrize("gap", [0, 0.004, 0.03, 0.15, 0.4])
+async def test_stream_ends_on_announced_size(tmp_path: Path, bit_depth: int, gap: float) -> None:
+    """The stream ends on the announced byte and decodes to the same samples."""
+    data = _encode(tmp_path, bit_depth)
+    target = int(len(data) * (1 + gap))
+    out, result = await _run(data, target, 25, int(target / (1 + pf.MARGIN_MODEL)))
+    assert result.status == "exact"
+    assert len(out) == target
+    assert result.natural == len(data)
+    assert _decode(out) == _decode(data)
+    if gap == 0:
+        assert out == data
+
+
+@needs_ffmpeg
+async def test_stream_larger_than_announced_is_untouched(tmp_path: Path) -> None:
+    """A stream that is larger than announced passes through unchanged."""
+    data = _encode(tmp_path, 16)
+    out, result = await _run(data, len(data) - 1000, 25, len(data))
+    assert result.status == "over"
+    assert out == data
+
+
+async def test_other_data_passes_through() -> None:
+    """Data that is not FLAC passes through unchanged."""
+    data = bytes(range(256)) * 400
+    out, result = await _run(data, len(data) + 5000, 10, len(data))
+    assert out == data
+    assert result.status == "short"
