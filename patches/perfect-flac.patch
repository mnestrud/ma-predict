+"""Tests for Perfect FLAC: the size estimate and the exact-length stream."""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import shutil
+import subprocess
+from typing import TYPE_CHECKING
+
+import numpy as np
+import pytest
+
+from music_assistant.helpers import perfect_flac as pf
+
+if TYPE_CHECKING:
+    from collections.abc import AsyncGenerator
+    from pathlib import Path
+
+FFMPEG = shutil.which("ffmpeg")
+needs_ffmpeg = pytest.mark.skipif(FFMPEG is None, reason="ffmpeg not installed")
+LOGGER = logging.getLogger(__name__)
+
+
+def _crc16_reference(data: bytes) -> int:
+    crc = 0
+    for byte in data:
+        crc ^= byte << 8
+        for _ in range(8):
+            crc = ((crc << 1) ^ 0x8005) & 0xFFFF if crc & 0x8000 else (crc << 1) & 0xFFFF
+    return crc
+
+
+def test_crc16_matches_reference() -> None:
+    """The vectorized CRC-16 equals the bitwise one."""
+    rng = np.random.default_rng(1)
+    for size in (1, 2, 17, 4096, 20001):
+        data = rng.integers(0, 256, size, dtype=np.uint8)
+        assert pf._crc16(data) == _crc16_reference(data.tobytes())
+
+
+def test_pack_bits() -> None:
+    """Fields are packed most significant bit first."""
+    packed = pf._pack_bits(np.array([0b101, 0, 0xFFFF, 1]), np.array([3, 0, 16, 2]))
+    assert packed.tobytes() == bytes([0b10111111, 0b11111111, 0b11101000])
+
+
+@pytest.mark.parametrize(
+    ("float_stage", "changed", "dynamic", "pcm", "out", "expected"),
+    [
+        (False, False, False, 16, 16, "R0"),
+        (False, False, False, 24, 16, "R3"),
+        (False, True, False, 24, 24, "R2"),
+        (True, False, False, 32, 24, "R1"),
+        (True, True, False, 32, 24, "R2"),
+        (True, True, False, 32, 16, "R3"),
+        (True, True, True, 32, 24, "R4"),
+    ],
+)
+def test_get_regime(
+    float_stage: bool, changed: bool, dynamic: bool, pcm: int, out: int, expected: str
+) -> None:
+    """The regime follows the float stage, sample changes and output depth."""
+    assert (
+        pf.get_regime(
+            float_stage=float_stage,
+            samples_changed=changed,
+            dynamic_normalization=dynamic,
+            pcm_bit_depth=pcm,
+            output_bit_depth=out,
+        )
+        == expected
+    )
+
+
+def _ratio(**overrides: object) -> float | None:
+    args: dict[str, object] = {
+        "source_size": 30_000_000,
+        "source_is_flac": True,
+        "source_rate": 44100,
+        "source_bit_depth": 16,
+        "source_channels": 2,
+        "output_rate": 44100,
+        "output_bit_depth": 16,
+        "output_channels": 2,
+        "duration": 240.0,
+        "regime": "R0",
+        "gain_db": 0.0,
+    }
+    args.update(overrides)
+    return pf.estimate_flac_ratio(**args)  # type: ignore[arg-type]
+
+
+def test_estimate_flac_ratio() -> None:
+    """V2: source bits per sample plus an offset, by regime."""
+    bits = 30_000_000 / (44100 * 2 * 2 * 240.5) * 16
+    assert _ratio() == pytest.approx((bits + 0.57) / 16)
+    assert _ratio(regime="R1", output_bit_depth=24) == pytest.approx((bits + 0.77) / 24)
+    assert _ratio(regime="R2", output_bit_depth=24, gain_db=-6.02) == pytest.approx(
+        (bits + 8 - 1 + 0.57) / 24
+    )
+    assert _ratio(source_is_flac=False) is None
+    assert _ratio(source_size=None) is None
+    assert _ratio(regime="R4") is None
+
+
+def test_estimate_flac_size_adds_margin() -> None:
+    """The announced size is the estimate plus the margin."""
+    announced, estimate = pf.estimate_flac_size(
+        ratio=0.7, output_rate=44100, output_bit_depth=16, output_channels=2, seconds=100
+    )
+    assert estimate == int(0.7 * 176400 * 100.5)
+    assert announced == int(estimate * (1 + pf.MARGIN_MODEL))
+
+
+def _encode(tmp_path: Path, bit_depth: int, seconds: int = 25) -> bytes:
+    assert FFMPEG
